{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "upstreamHost", "ingress", "publicProxy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "upstreamHost": {"$ref": "#/definitions/hostname"},
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "clusterIssuer", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"$ref": "#/definitions/hostname"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "clusterIssuer": {"type": "string"},
        "tls": {
          "type": "object",
          "required": ["secretName"],
          "properties": {"secretName": {"type": "string"}}
        }
      }
    },
    "publicProxy": {
      "type": "object",
      "required": ["enabled", "host", "upstreams", "tls"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"$ref": "#/definitions/hostname"},
        "upstreams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]+)?$"
          }
        },
        "tls": {
          "type": "object",
          "required": ["secretName"],
          "properties": {"secretName": {"type": "string"}}
        }
      }
    },
    "resources": {"type": "object"}
  },
  "definitions": {
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?[.])+[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    }
  }
}

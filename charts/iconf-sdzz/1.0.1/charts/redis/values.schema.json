{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "redis",
    "resources",
    "persistence"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "configSecret"
      ],
      "properties": {
        "configSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "persistence": {
      "type": "object",
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "size"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "storageClass": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

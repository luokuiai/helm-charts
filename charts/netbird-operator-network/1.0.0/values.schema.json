{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["router", "resource"],
  "properties": {
    "router": {
      "type": "object",
      "required": ["name", "dnsZone", "replicas"],
      "properties": {
        "name": {"$ref": "#/definitions/name"},
        "dnsZone": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "resource": {
      "type": "object",
      "required": ["serviceName", "groupNames"],
      "properties": {
        "serviceName": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
        },
        "groupNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    }
  }
}
